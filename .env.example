# ─── LLM gateway (Portkey-style proxy) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://your-llm-gateway.example.com
# Model id used by all agents — verify against your gateway
LLM_MODEL=your-model-id
# Optional per-agent overrides
# WRITER_MODEL=
# REVIEWER_MODEL=
# REVISER_MODEL=

# Portkey credentials (Style B)
PORTKEY_API_KEY=pk-...
PORTKEY_PROVIDER=@your-provider

# ─── Glean (cookie-based SSO — no API key) ───────────────────────────────────
GLEAN_SERVER_URL=https://your-glean-instance.example.com
# Copy from DevTools → Application → Cookies → your-glean-instance
# (Chrome auto-extract is used when these are unset and Chrome is closed)
GLEAN_SESSION_COOKIE=
GLEAN_AZURE_COOKIE=

# ─── Knowledge base (multi-branch git repo) ──────────────────────────────────
KB_LOCAL_PATH=C:\path\to\knowledge-base-clone

# ─── Tuning ──────────────────────────────────────────────────────────────────
RATE_LIMIT_SECONDS=32
MAX_REVISIONS=3
MAX_RETRIEVAL_RETRIES=2

# ─── Vector store ────────────────────────────────────────────────────────────
# chroma = local index (default) | pinecone = shared cloud index (hosting)
VECTOR_BACKEND=chroma
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=kb-knowledge
# Optional speed tuning:
# GRADE_SHORTCUT=1
# GRADE_SHORTCUT_THRESHOLD=0.45
# TLS verification off ONLY behind the corporate proxy; keep 0 on hosting
# PINECONE_INSECURE_TLS=0
